{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A single chat message.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "The sender role"
        },
        "text": {
          "type": "string",
          "description": "The message content",
          "maxLength": 10000
        },
        "timestamp": {
          "type": "string",
          "description": "Server timestamp of the message"
        }
      },
      "required": ["role", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Chat history for a given user."
    }
  }
}
